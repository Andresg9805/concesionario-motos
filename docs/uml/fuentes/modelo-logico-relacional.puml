@startuml modelo-logico-relacional
skinparam linetype ortho

entity "marcas" {
  + id : int [PK]
  --
  nombre : varchar [UNIQUE]
  color_hex : varchar(7)
  descripcion : text
}

entity "tipos_moto" {
  + id : int [PK]
  --
  clave : varchar(20) [UNIQUE]
  nombre : varchar [UNIQUE]
}

entity "motos" {
  + id : int [PK]
  --
  # marca_id : int [FK]
  # tipo_id : int [FK]
  modelo : varchar
  anio : smallint
  cilindraje_cc : int
  precio_cop : int
  stock : int
  consumo_km_galon : float
  costo_mantenimiento_km_cop : int
  descripcion : text
  imagen_url : varchar
  .. UNIQUE(marca_id, modelo, anio) ..
}

entity "parametros_costo" {
  + id : int [PK]
  --
  precio_galon_cop : int
  porcentaje_impuesto : decimal(5,2)
  valor_matricula_cop : int
  valor_tramites_cop : int
  tasa_mensual : decimal(6,4)
  actualizado_en : datetime
}

entity "tarifas_soat" {
  + id : int [PK]
  --
  cilindraje_min : smallint
  cilindraje_max : smallint
  valor_anual_cop : int
}

entity "busquedas" {
  + id : int [PK]
  --
  fecha : datetime
  cuota_maxima_cop : int
  cuota_inicial_cop : int
  categoria_licencia : enum("A1", "A2")
  uso : enum("ciudad", "carretera", "trabajo")
  # marca_id : int [FK, nullable]
  cantidad_resultados : int
}

entity "personas" {
  + id : int [PK]
  --
  nombre : varchar
  correo : varchar [UNIQUE]
  telefono : varchar(20)
}

entity "usuarios" {
  + id : int [PK]
  --
  # persona_id : int [FK, UNIQUE]
  hash_contrasena : varchar
  rol : enum("cliente", "asesor", "admin")
}

entity "asesores" {
  + usuario_id : int [PK, FK]
  --
  # marca_id : int [FK]
}

entity "cotizaciones" {
  + id : int [PK]
  --
  codigo_seguimiento : varchar [UNIQUE]
  # cliente_id : int [FK]
  # moto_id : int [FK]
  # asesor_id : int [FK]
  fecha : date
  precio_cop : int
  cuota_inicial_cop : int
  plazo_meses : smallint
  tasa_mensual : decimal(7,4)
  estado_atencion : enum("nuevo", "contactado", "test_drive", "negociando", "vendido", "descartado")
}

entity "test_drives" {
  + id : int [PK]
  --
  codigo_seguimiento : varchar [UNIQUE]
  # cliente_id : int [FK]
  # moto_id : int [FK]
  # asesor_id : int [FK]
  fecha_solicitud : datetime
  fecha_programada : datetime [nullable]
  estado : enum("pendiente", "programado", "realizado", "cancelado")
}

entity "fabricantes" {
  + id : int [PK]
  --
  nombre : varchar [UNIQUE]
}

entity "categorias_accesorio" {
  + id : int [PK]
  --
  clave : varchar(20) [UNIQUE]
  nombre : varchar [UNIQUE]
}

entity "accesorios" {
  + id : int [PK]
  --
  sku : varchar [UNIQUE]
  nombre : varchar
  # categoria_id : int [FK]
  # fabricante_id : int [FK]
  descripcion : text
  precio_cop : int
  stock : int
  imagen_url : varchar
}

entity "departamentos" {
  + codigo : char(2) [PK]
  --
  nombre : varchar
  costo_envio_cop : int
  dias_envio : smallint
}

entity "municipios" {
  + codigo : char(5) [PK]
  --
  nombre : varchar
  # departamento_codigo : char(2) [FK]
}

entity "direcciones" {
  + id : int [PK]
  --
  # usuario_id : int [FK]
  # municipio_codigo : char(5) [FK]
  nombre_recibe : varchar
  telefono_contacto : varchar(20)
  detalle : text
}

entity "pedidos" {
  + id : int [PK]
  --
  # usuario_id : int [FK]
  # direccion_id : int [FK]
  estado : enum("pendiente_pago", "pagado", "expirado")
  costo_envio_cop : int
  creado_en : datetime
  reservado_hasta : datetime
}

entity "items_pedido" {
  + id : int [PK]
  --
  # pedido_id : int [FK]
  # accesorio_id : int [FK]
  cantidad : int
  precio_unitario_cop : int
}

entity "pagos" {
  + id : int [PK]
  --
  # pedido_id : int [FK]
  referencia : varchar [UNIQUE]
  transaccion_id : varchar [nullable]
  metodo : enum("tarjeta", "nequi", "pse")
  estado : enum("pendiente", "aprobado", "rechazado", "error")
  monto_cop : int
  creado_en : datetime
  actualizado_en : datetime
}

entity "eventos_pago" {
  + id : int [PK]
  --
  # pago_id : int [FK]
  checksum : varchar [UNIQUE]
  estado_recibido : varchar
  recibido_en : datetime
}

entity "envios" {
  + id : int [PK]
  --
  # pedido_id : int [FK, UNIQUE]
  numero_guia : varchar [UNIQUE]
  creado_en : datetime
}

entity "eventos_envio" {
  + id : int [PK]
  --
  # envio_id : int [FK]
  estado : enum("preparando", "enviado", "en_camino", "entregado")
  fecha : datetime
  nota : text
}

' Relaciones

marcas ||--o{ motos
tipos_moto ||--o{ motos
marcas |o--o{ busquedas
marcas ||--o{ asesores

personas ||--o| usuarios
usuarios ||--o| asesores

motos ||--o{ cotizaciones
motos ||--o{ test_drives
personas ||--o{ cotizaciones
personas ||--o{ test_drives
asesores ||--o{ cotizaciones
asesores ||--o{ test_drives

fabricantes ||--o{ accesorios
categorias_accesorio ||--o{ accesorios
accesorios ||--o{ items_pedido

usuarios ||--o{ direcciones
usuarios ||--o{ pedidos

departamentos ||--o{ municipios
municipios ||--o{ direcciones
direcciones ||--o{ pedidos

pedidos ||--|{ items_pedido
pedidos ||--o{ pagos
pedidos ||--o| envios

pagos ||--o{ eventos_pago
envios ||--o{ eventos_envio

@enduml
